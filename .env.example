# Copy to .env.local and fill in your Supabase project values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Server-only — required for private signed-agreement PDF uploads and portal links
# Supabase → Project Settings → API → service_role (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Optional — enables automatic headquarters_profile table creation on server
# Supabase → Project Settings → Database → Connection string (URI)
SUPABASE_DB_URL=

NEXT_PUBLIC_SUPABASE_ENABLED=false
NEXT_PUBLIC_PERSISTENCE_BACKEND=session

# Membership unlock timing for first-time activation: full (~11s) or fast (~5.6s)
# Returning members skip the ceremony automatically unless they choose replay.
NEXT_PUBLIC_UNLOCK_TIMING=full

# Headquarters PIN — required to enter /hq (8-hour browser session)
# Set in .env.local locally and in Vercel Environment Variables for production.
# If unset, admin access fails closed unless private beta is explicitly enabled.
# Server-only founder access. Never prefix this with NEXT_PUBLIC_.
ADMIN_PIN=
# Development/demo escape hatch only. Leave unset in production.
ADMIN_PRIVATE_BETA=false

# Google Reviews (server-only — never use NEXT_PUBLIC)
# Places API Place Details for live rating, review count, and review preview.
GOOGLE_MAPS_API_KEY=
GOOGLE_BUSINESS_PUBLIC_FULL_REVIEWS_ENABLED=false
GOOGLE_REVIEW_REQUEST_URL=
GOOGLE_PLACE_ID=

# Google Business OAuth (server-only) — powers "Use my Google Business" in setup wizard
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 32 random bytes encoded as base64 (or 64 hex characters). You may reuse the
# existing JOBBER_TOKEN_ENCRYPTION_KEY.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Optional override (defaults to https://YOUR_DOMAIN/api/admin/google-reviews/oauth/callback)
# GOOGLE_OAUTH_REDIRECT_URI=

# Jobber OAuth — server-only, read-only Care Operations connection
# Enter the callback shown in Headquarters into the Jobber draft app exactly.
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_TOKEN_ENCRYPTION_KEY=
# Required in production, for example:
# JOBBER_OAUTH_REDIRECT_URI=https://your-production-domain.com/api/admin/care-operations/jobber/oauth/callback
# Pin deliberately; update only after testing a newer active Jobber API version.
JOBBER_GRAPHQL_VERSION=2025-04-16
# Random server-only value (16+ characters). Vercel sends it as a Bearer token
# when invoking the daily Jobber repair snapshot in vercel.json.
CRON_SECRET=

# Member Intelligence — AI Quote Engine (server-only)
OPENAI_API_KEY=
# OPENAI_QUOTE_MODEL=gpt-4o
# Optional presentation-plan model override. Defaults to gpt-5.4-mini.
# OPENAI_PRESENTATION_MODEL=gpt-5.4-mini

# Resend customer email + Digital Agreement System (server-only)
# RESEND_API_KEY=re_...
# Verified senders. Communications falls back to RESEND_AGREEMENT_FROM when its
# dedicated sender is unset.
# RESEND_COMMUNICATIONS_FROM=SqueegeeKing <hello@squeegeeking.net>
# RESEND_AGREEMENT_FROM=SqueegeeKing <agreements@squeegeeking.net>
# Monitored mailbox where customer email replies should arrive.
# RESEND_COMMUNICATIONS_REPLY_TO=hello@squeegeeking.net
# Signing secret from the Resend delivery webhook pointed at:
# https://YOUR_DOMAIN/api/integrations/resend/webhook
# RESEND_WEBHOOK_SECRET=whsec_...
# Comma-separated — notified on every /request lead submission
# LEAD_NOTIFY_EMAIL=noah@squeegeeking.net,dasan@squeegeeking.net
# Active sales-rep slug that should own each new website/Facebook lead with a
# 15-minute next action. Assignment does not email or text the customer.
# INBOUND_LEAD_OWNER_SLUG=noah

# Twilio transactional SMS (server-only)
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# Use either a sending number or a Messaging Service SID.
# TWILIO_FROM_NUMBER=+15305551234
# TWILIO_MESSAGING_SERVICE_SID=MG...
# Set true only after Twilio shows the chosen U.S. sender/registration approved.
TWILIO_SENDER_APPROVED=false
# Set this exact public URL in Vercel and use the same URL as Twilio's status
# callback for outbound messages:
# TWILIO_STATUS_CALLBACK_URL=https://YOUR_DOMAIN/api/integrations/twilio/status
# Configure the Twilio number's incoming-message webhook separately as:
# https://YOUR_DOMAIN/api/integrations/twilio/inbound
# Comma-separated business-controlled phones that receive private HOT LEAD alerts.
# LEAD_NOTIFY_SMS=+15305551234

# Meta/Facebook Lead Ads (server-only)
# Webhook callback: https://YOUR_DOMAIN/api/integrations/meta/leads
# META_WEBHOOK_VERIFY_TOKEN=generate-a-long-random-value
# META_APP_SECRET=from-the-Meta-app-dashboard
# META_PAGE_ACCESS_TOKEN=long-lived-page-access-token
# Pin the Graph API version configured for the Meta app (for example vXX.X).
# META_GRAPH_API_VERSION=
# Comma-separated Instant Form IDs whose disclosure explicitly authorizes SMS.
# META_SMS_CONSENT_FORM_IDS=
# Comma-separated field keys used by those forms for the SMS consent answer.
# META_SMS_CONSENT_FIELD_NAMES=sms_consent,text_message_consent
# Version label for the exact disclosure shown on the approved form(s).
# META_SMS_CONSENT_DISCLOSURE_VERSION=
# Atlas records the current Meta callback challenge and signed event without
# storing either secret. Submit one safe test lead after Page leadgen
# subscription so HQ can verify the complete Facebook-to-CRM path.

# Stripe card-on-file (SetupIntent + Elements)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...
# Signing secret for https://YOUR_DOMAIN/api/integrations/stripe/webhook
# Subscribe that endpoint to setup_intent.succeeded plus the existing
# payment_intent.succeeded, payment_intent.payment_failed, and
# payment_intent.requires_action events.
# STRIPE_WEBHOOK_SECRET=whsec_...
# Set only after a Stripe test event proves setup_intent.succeeded reaches the
# production endpoint and opens the matching HomeAtlas portal.
STRIPE_ENROLLMENT_SETUP_WEBHOOK_CONFIRMED=false
# Never enable on production. Allows no-card activation in local demos only.
ALLOW_MOCK_PAYMENT=false

# Customer enrollment handoff (server-only)
# Legal identity must match the owner-released MSA and California notices.
# HOMEATLAS_LEGAL_COMPANY_NAME=Exact legal LLC name from released documents
# HOMEATLAS_LEGAL_BUSINESS_ADDRESS=...
# HOMEATLAS_LEGAL_NOTICE_EMAIL=...
# HOMEATLAS_LEGAL_PHONE=...
# Enrollment starts fail-closed in rehearsal mode. Only the configured
# business-controlled address can receive a DocuSign envelope until the full
# rehearsal is complete and live mode is explicitly confirmed.
# HOMEATLAS_ENROLLMENT_RELEASE_MODE=rehearsal
# HOMEATLAS_ENROLLMENT_REHEARSAL_EMAIL=owner-controlled@example.com
# HOMEATLAS_ENROLLMENT_REHEARSAL_CONFIRMED=false
# DocuSign remote email signing. Store the RSA private key as base64-encoded PEM.
# DOCUSIGN_INTEGRATION_KEY=...
# DOCUSIGN_USER_ID=...
# DOCUSIGN_ACCOUNT_ID=...
# DOCUSIGN_ACCOUNT_BASE_URI=https://na4.docusign.net
# DOCUSIGN_AUTH_SERVER=account.docusign.com
# DOCUSIGN_PRIVATE_KEY_BASE64=...
# DOCUSIGN_ENROLLMENT_TEMPLATE_ID=...
# DOCUSIGN_CUSTOMER_ROLE_NAME=Customer
# Enable HMAC signing in DocuSign Connect and copy its secret here.
# Webhook: https://YOUR_DOMAIN/api/integrations/docusign/connect
# DOCUSIGN_CONNECT_HMAC_SECRET=...

# Founding member cohort — unset = all new memberships are founding until you set an end date
# FOUNDING_PERIOD_END=2026-12-31T23:59:59.999Z

# Public app URL for customer emails and portal magic links
# NEXT_PUBLIC_APP_URL=https://your-production-domain.com
